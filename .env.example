# Copy to .env and fill in. Never commit .env.

# Earnings calendar. Required when earnings.provider = "earningsapi"
# (the default). Get a key at https://www.earningsapi.com/
EARNINGS_API_KEY=

# Only needed if you switch earnings.provider to "alphavantage".
# The literal value "demo" works for the full earnings calendar download.
ALPHA_VANTAGE_API_KEY=

# Optional, only used when notifications.provider = "discord"
DISCORD_WEBHOOK_URL=

# Optional, only used when notifications.provider = "email"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Sent as the User-Agent to government sites. Several of them (BLS in
# particular) reject requests that do not identify a contact address.
CONTACT_EMAIL=
